# Docker Hub credentials
DOCKERHUB_USERNAME=your-dockerhub-username

# Let's Encrypt email
ACME_EMAIL=your-email@example.com

# Site URL (used during build)
NEXT_PUBLIC_SITE_URL=https://neuralcosmology.com

# Mailgun SMTP for contact form (/api/contact)
MAILGUN_SMTP_HOST=smtp.mailgun.org
MAILGUN_SMTP_PORT=2525
MAILGUN_SMTP_USERNAME=postmaster@your-domain.mailgun.org
MAILGUN_SMTP_PASSWORD=your-mailgun-smtp-password
MAILGUN_FROM_EMAIL=info@neuralcosmology.com
CONTACT_EMAIL=info@neuralcosmology.com


# ---- Online library (/[locale]/read/<book>/<chapter>) ----
# Экспорт LaTeX → HTML (godacademy: make reader). В проде — volume
# /opt/projects/neurocosmology/library, симлинк current → releases/<sha>.
LIBRARY_DIR=/path/to/godacademy/build/reader

# INITE Auth (OIDC). Клиент регистрируется в inite-auth-service:
# redirect URI https://neuralcosmology.com/api/auth/callback
INITE_AUTH_ISSUER=https://auth-api.inite.ai
INITE_AUTH_CLIENT_ID=neuralcosmology
INITE_AUTH_CLIENT_SECRET=
# openssl rand -base64 48
SESSION_SECRET=

# INITE Billing. Пока false — закрытые главы открываются после входа.
# true — нужен entitlement neuralcosmology:library или neuralcosmology:book:<slug>.
PAYWALL_ENABLED=false
BILLING_API_URL=
BILLING_API_KEY=
# Страница оплаты книги, {book} → slug. Пусто — кнопка «Купить» ведёт на почту.
BOOK_CHECKOUT_URL=
